{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "mcp__Supabase",
      "mcp__github",
      "mcp__Claude_Code_Remote",
      "Agent",
      "Skill",
      "SendUserFile",
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "mcp__Trello",
      "mcp__Vercel",
      "mcp__Claude_Docs",
      "mcp__Notion",
      "mcp__Gmail",
      "mcp__Google_Calendar",
      "mcp__Google_Drive",
      "mcp__ccd_session"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__Supabase__execute_sql|mcp__Supabase__apply_migration",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ask-before-destructive-sql.sh",
            "timeout": 10,
            "statusMessage": "Checking the SQL for deletions"
          }
        ]
      }
    ]
  }
}
